# Upstream repos -- reclone with scripts/setup_baselines.sh
baselines/

# Weights and cached latents
checkpoints/
*.ckpt
*.safetensors
*.pth

# Experiment outputs; commit configs and the notes in docs/, not the artifacts
experiments/*/
!experiments/.gitkeep
runs/
wandb/
outputs/
*.npz
fid_stats/

# Data. Anchored: a bare `data/` also matches herald/data/, which is source.
/data/
*.tar
*.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/

# Env
.env
.venv/

# Paper, course deliverables and talks: kept locally and in Overleaf, not in the code repo
/submission/
/ProjectTemplate/
/slides/

# Editor/agent config and empty scaffolding
/.cursor/
/assets/
/configs/

# Stray run logs at the top of experiments/ (per-run logs live in experiments/<id>/)
experiments/*.log
