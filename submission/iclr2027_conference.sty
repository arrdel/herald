%%%% ICLR 2027 conference style (reimplementation)
%%
%% The official ICLR 2027 package is not published at the time of writing, so this is a
%% self-contained reimplementation of the ICLR conference format, which has been stable for years:
%% US Letter, 10pt, single column, 5.5in x 9in text block, numbered lines in submission mode,
%% double-blind author block, and natbib author-year citations.
%%
%% Deliberately depends only on packages present in every TeX distribution, so it compiles without
%% network access. \iclrfinalcopy switches from the anonymous submission form to the camera-ready.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2027_conference}[2026/09/03 ICLR 2027 conference style]

\RequirePackage{geometry}
\RequirePackage{natbib}
\RequirePackage{fancyhdr}

%% ICLR specifies Times. The classic \usepackage{times} is a pdfTeX-era package and leaves the
%% Unicode engines without a mapped font shape, so branch on the engine and use the TeX Gyre Termes
%% clone, which is metrically identical and available to both.
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{times}
\else
  %% Addressed by file name rather than by system font name: a Unicode engine run without a system
  %% font database (as in a containerised or fetch-on-demand build) cannot resolve "TeX Gyre Termes",
  %% but the .otf files themselves are part of every distribution.
  \RequirePackage{fontspec}
  \setmainfont{texgyretermes}[
    Extension      = .otf,
    UprightFont    = *-regular,
    BoldFont       = *-bold,
    ItalicFont     = *-italic,
    BoldItalicFont = *-bolditalic]
  \setsansfont{texgyreheros}[
    Extension   = .otf,
    UprightFont = *-regular,
    BoldFont    = *-bold,
    ItalicFont  = *-italic]
\fi

\geometry{letterpaper, textwidth=5.5in, textheight=9.0in, top=1.0in, left=1.5in, headsep=0.25in,
          footskip=0.4in}

\newif\if@iclrfinal\@iclrfinalfalse
\newcommand{\iclrfinalcopy}{\@iclrfinaltrue}

%% ---------------------------------------------------------------------------------------------
%% Line numbers, submission mode only.
%% lineno is standard but guarded anyway: a missing package must degrade to an unnumbered document
%% rather than refuse to build, since a reviewer copy is worth more than the margin numbers.
%% ---------------------------------------------------------------------------------------------
\IfFileExists{lineno.sty}{%
  \RequirePackage[left]{lineno}%
  \AtBeginDocument{\if@iclrfinal\else\linenumbers\fi}%
  \renewcommand\linenumberfont{\normalfont\tiny\sffamily\color{gray}}%
}{}

\RequirePackage{xcolor}

%% ---------------------------------------------------------------------------------------------
%% Title and authors.
%% ---------------------------------------------------------------------------------------------
\newcommand{\iclrheading}{ICLR 2027 Conference Submission}

\renewcommand{\maketitle}{%
  \vbox{%
    \hsize\textwidth
    \linewidth\hsize
    \vskip 0.1in
    \begin{center}
      {\LARGE\bfseries \@title \par}
      \vskip 0.25in
      \if@iclrfinal
        {\large \@author \par}
      \else
        {\large \bfseries Anonymous authors \par}
        {\large Paper under double-blind review \par}
      \fi
    \end{center}
    \vskip 0.2in
  }%
}

%% ---------------------------------------------------------------------------------------------
%% Abstract: indented on both sides, centred bold heading.
%% ---------------------------------------------------------------------------------------------
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}
}{%
  \end{quote}
  \vspace{1ex}
}

%% ---------------------------------------------------------------------------------------------
%% Sectioning.
%% ---------------------------------------------------------------------------------------------
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-0.24in \@plus -1ex \@minus -.2ex}{0.09in \@plus.2ex}%
  {\large\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-0.20in \@plus -1ex \@minus -.2ex}{0.07in \@plus.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-0.16in \@plus -1ex \@minus -.2ex}{0.05in \@plus.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 1ex \@minus .2ex}{-1em}%
  {\normalsize\bfseries}}

\setcounter{secnumdepth}{3}

%% ---------------------------------------------------------------------------------------------
%% Running head and page numbers.
%% ---------------------------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\sffamily \iclrheading}
\fancyfoot[C]{\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyhead[C]{\small\sffamily \iclrheading}\fancyfoot[C]{\small\thepage}}

\parskip 0.06in
\parindent 0pt

\endinput
